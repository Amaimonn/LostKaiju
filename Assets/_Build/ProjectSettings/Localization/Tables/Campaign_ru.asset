  m_TableData:
  - m_Id: 1477436817408
    m_Localized: "\u041E\u043D\u0438 \u043D\u0435 \u043A\u0430\u043C\u043D\u0438.
      \u041E\u043D\u0438 \u2014 \u043E\u043A\u0430\u043C\u0435\u043D\u0435\u0432\u0448\u0438\u0435
      \u0441\u043D\u044B.\n\u0417\u0430\u0441\u0442\u044B\u0432\u0448\u0438\u0435
      \u043A\u0430\u043F\u043B\u0438 \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0445\u0430, \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0435
      \u0432 \u043A\u0430\u043C\u0435\u043D\u044C. \u041F\u0440\u0438\u043A\u043E\u0441\u043D\u0435\u0448\u044C\u0441\u044F
      \u2014 \u0438 \u0441\u043A\u0432\u043E\u0437\u044C \u043A\u043E\u0436\u0443
      \u043F\u0440\u043E\u0441\u043E\u0447\u0438\u0442\u0441\u044F \u0447\u0443\u0436\u0430\u044F
      \u0442\u043E\u0441\u043A\u0430. \u041D\u043E \u0443\u0434\u0430\u0440... \u0443\u0434\u0430\u0440
      \u0431\u0443\u0434\u0438\u0442 \u0438\u0445. \u041D\u0430 \u043C\u0438\u0433
      \u043E\u043D\u0438 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043F\u044B\u043B\u044C, \u0448\u0435\u043F\u0447\u0443\u0449\u0443\u044E
      \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C\u0438 \u0437\u0430\u0431\u044B\u0442\u044B\u0445
      \u043A\u043E\u0448\u043C\u0430\u0440\u043E\u0432.\n\u041F\u0440\u044B\u0436\u043E\u043A
      \u0437\u0434\u0435\u0441\u044C \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u042D\u0442\u043E \u043F\u043E\u0431\u0435\u0433.
      \u041E\u0442 \u0448\u0438\u043F\u043E\u0432? \u041E\u0442 \u043D\u0438\u0445
      \u0441\u0430\u043C\u0438\u0445?\n\u0420\u0430\u0437\u0431\u0435\u0439 \u0442\u0438\u0448\u0438\u043D\u0443.
      \u041F\u0440\u043E\u0441\u043D\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 672440827904
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E \u043F\u043E\u0434 \u0433\u043E\u0440\u043E\u0434\u043E\u043C,
      \u0433\u0434\u0435 \u0441\u0432\u0435\u0442 \u0435\u0434\u0432\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u0432 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438,
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043F\u0443\u0442\u044C.
      \u041D\u043E \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0443\u0442\u044C \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u0443\u043D\u043D\u0435\u043B\u0438
      \u2014 \u044D\u0442\u043E \u043F\u0443\u0442\u044C \u0441\u043A\u0432\u043E\u0437\u044C
      \u0437\u0430\u0431\u044B\u0442\u044C\u0435. \u041F\u0435\u0440\u0432\u044B\u0435
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u0437\u0434\u0435\u0441\u044C
      \u043E\u043A\u0443\u0442\u0430\u043D\u044B \u0442\u0443\u043C\u0430\u043D\u043E\u043C
      \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u041A\u0442\u043E
      \u0442\u044B? \u041A\u0430\u043A \u0442\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C? \u041E\u0442\u0432\u0435\u0442\u043E\u0432
      \u043D\u0435\u0442, \u043B\u0438\u0448\u044C \u0442\u044F\u0436\u0435\u043B\u044B\u0439,
      \u0441\u044B\u0440\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u043B\u0435\u0433\u043A\u0438\u0435,
      \u0438 \u0434\u0430\u043B\u0435\u043A\u0438\u0435, \u043D\u0435\u044F\u0441\u043D\u044B\u0435
      \u0437\u0432\u0443\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0442\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0442\u0441\u044F,
      \u0442\u043E \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0438\u0433\u0440\u0430\u044E\u0442 \u0441 \u0442\u043E\u0431\u043E\u0439.\r\n\u0421
      \u043A\u0430\u0436\u0434\u044B\u043C \u0448\u0430\u0433\u043E\u043C \u0441\u0442\u0435\u043D\u044B
      \u0441\u043B\u043E\u0432\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0441\u0436\u0438\u043C\u0430\u044E\u0442 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
      \u0432\u043E\u043A\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 742762528768
    m_Localized: "\u0413\u043B\u0443\u0431\u0436\u0435. \u0422\u0435\u043C\u043D\u0435\u0435.
      \u0422\u0438\u0448\u0435. \u0422\u044B \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432\u0441\u0451 \u043D\u0438\u0436\u0435, \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0441\u0432\u0435\u0442 \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u0430\u0431\u043E\u0435
      \u043C\u0435\u0440\u0446\u0430\u043D\u0438\u0435 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F
      \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u043F\u0443\u0442\u044C.
      \u0417\u0434\u0435\u0441\u044C, \u0432 \u044D\u0442\u043E\u0439 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
      \u043F\u0443\u0441\u0442\u043E\u0442\u0435, \u0437\u0435\u043C\u043B\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438. \u0412\u043C\u0435\u0441\u0442\u043E
      \u043D\u0435\u0451 \u2014 \u043B\u0438\u0448\u044C \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0438
      \u0442\u0432\u0435\u0440\u0434\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438,
      \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0435 \u0432
      \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u043A\u0430\u043A \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u0437\u0430\u0431\u044B\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430.\n\u041F\u0440\u044B\u0436\u043A\u0438.
      \u041E\u043D\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432\u043F\u0435\u0440\u0435\u0434.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445 \u2014
      \u044D\u0442\u043E \u0448\u0430\u0433 \u0432 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C.
      \u041F\u043E\u0434 \u0442\u043E\u0431\u043E\u0439 \u2014 \u0431\u0435\u0437\u0434\u043D\u0430,
      \u0447\u0435\u0440\u043D\u0430\u044F \u0438 \u0431\u0435\u0437\u0434\u043E\u043D\u043D\u0430\u044F,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0441\u0430\u043C\u0430 \u0441\u043C\u0435\u0440\u0442\u044C.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0437\u043E\u0432\u0435\u0442 \u0442\u0435\u0431\u044F,
      \u043C\u0430\u043D\u0438\u0442, \u043E\u0431\u0435\u0449\u0430\u044F \u043A\u043E\u043D\u0435\u0446
      \u0432\u0441\u0435\u043C \u0442\u0432\u043E\u0438\u043C \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044F\u043C
      \u0438 \u0441\u0442\u0440\u0430\u0445\u0430\u043C. \u041D\u043E \u0442\u044B
      \u0437\u043D\u0430\u0435\u0448\u044C: \u043E\u0434\u0438\u043D \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439
      \u0448\u0430\u0433, \u0438 \u0442\u044B \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0448\u044C
      \u0432 \u043D\u0435\u0439 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1492985102336
    m_Localized: "\u041D\u0430\u0434 \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u043C
      \u043C\u043E\u0440\u0435\u043C \u0442\u0451\u043C\u043D\u044B\u0445 \u0437\u0434\u0430\u043D\u0438\u0439,
      \u043F\u043E\u0434 \u043D\u0438\u0437\u043A\u0438\u043C, \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044B\u043C
      \u0441\u043C\u043E\u0433\u043E\u043C \u043D\u0435\u0431\u043E\u043C, \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u043B\u0441\u044F
      \u043C\u0438\u0440, \u0433\u0434\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C.
      \u041A\u0440\u044B\u0448\u0438, \u0441\u043B\u043E\u0432\u043D\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u0430
      \u0432 \u043E\u043A\u0435\u0430\u043D\u0435 \u043F\u0443\u0441\u0442\u043E\u0442\u044B,
      \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C\u0438
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044F\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u0431\u0435\u0437\u0434\u043E\u043D\u043D\u044B\u043C\u0438.
      \u0422\u0438\u0448\u0438\u043D\u0430.\r\n\u0418 \u0432\u0434\u0440\u0443\u0433
      \u2014 \u0442\u044B.\n\u0412\u044B\u0431\u0440\u0430\u0432\u0448\u0438\u0439\u0441\u044F
      \u0438\u0437 \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0433\u043E \u0447\u0440\u0435\u0432\u0430,
      \u0442\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0438\u0434\u0438\u0448\u044C
      \u0433\u043E\u0440\u043E\u0434 \u0442\u0430\u043A\u0438\u043C. \u041E\u043D
      \u043D\u0435 \u0441\u043F\u0438\u0442. \u041E\u043D \u0437\u0430\u043C\u0435\u0440.
      \u0414\u044B\u043C \u0438\u0437 \u0431\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u044B\u0445
      \u0442\u0440\u0443\u0431 \u0441\u0442\u0435\u043B\u0435\u0442\u0441\u044F \u043F\u043E
      \u0443\u043B\u0438\u0446\u0430\u043C, \u043A\u0430\u043A \u043F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u0430\u044F
      \u0440\u0435\u043A\u0430. \u0413\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0438
      \u043C\u0435\u0440\u0446\u0430\u044E\u0442 \u043E\u0433\u043D\u0438 \u2014
      \u0442\u043E \u043B\u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u044B, \u0442\u043E
      \u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0432\u0437\u0434\u043E\u0445\u0438
      \u043C\u0430\u0448\u0438\u043D.\n\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435...
      \u041A\u0442\u043E \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 1510974472192
    m_Localized: "\u041C\u0435\u0436\u0434\u0443 \u043A\u0440\u044B\u0448\u0430\u043C\u0438,
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0431\u044B\u043B\u0438 \u0443\u043B\u0438\u0446\u044B, \u0442\u0435\u043F\u0435\u0440\u044C
      \u043B\u0438\u0448\u044C \u043F\u0443\u0441\u0442\u043E\u0442\u0430. \u041D\u043E
      \u044D\u0442\u0430 \u043F\u0443\u0441\u0442\u043E\u0442\u0430 \u043D\u0435
      \u043C\u0435\u0440\u0442\u0432\u0430 \u2014 \u043E\u043D\u0430 \u0436\u0438\u0432\u0430\u044F,
      \u0434\u044B\u0448\u0430\u0449\u0430\u044F...\r\n\u0410, \u0442\u0430\u043A
      \u044D\u0442\u043E \u0432\u044B.\r\n\u0422\u0435 \u0441\u0430\u043C\u044B\u0435
      \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0442\u0440\u0430\u0436\u0438
      \u2014 \u0431\u0435\u0437\u043B\u0438\u043A\u0438\u0435, \u043D\u0435\u0443\u043C\u043E\u043B\u0438\u043C\u044B\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0443\u0437\u043D\u0430\u0451\u0448\u044C
      \u0438\u0445 \u0441\u0440\u0430\u0437\u0443: \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u0431\u043B\u0435\u0441\u043A \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432,
      \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043F\u043B\u0430\u0432\u043D\u043E\u0441\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439,
      \u0431\u0443\u0434\u0442\u043E \u043E\u043D\u0438 \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442
      \u043F\u043E \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u043C \u0440\u0435\u043B\u044C\u0441\u0430\u043C.
      \u041E\u043D\u0438 \u2014 \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u0430. \u041A\u0430\u043A \u0448\u0438\u043F\u044B
      \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435, \u043A\u0430\u043A
      \u044D\u0442\u0438 \u043F\u0430\u0440\u044F\u0449\u0438\u0435 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.\n\u041F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0436\u0435 \u043C\u0430\u043D\u044F\u0442,
      \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0435 \u0443\u0437\u043E\u0440\u043E\u043C
      \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0442\u0440\u0435\u0449\u0438\u043D.
      \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C:
      \u0433\u0434\u0435 \u043F\u0430\u0440\u044F\u0442 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u2014 \u0442\u0430\u043C \u0438 \u0441\u0442\u0440\u0430\u0436\u0438. \u0413\u0434\u0435
      \u0441\u0442\u0440\u0430\u0436\u0438 \u2014 \u0442\u0430\u043C \u0438 \u0438\u0445
      \u0441\u043B\u0435\u043F\u044B\u0435 \u0437\u043E\u043D\u044B.\r\n\u041E\u043D\u0438
      \u043D\u0435 \u0434\u0440\u0443\u0437\u044C\u044F. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 749595049984
    m_Localized: "\u0422\u044B \u0438\u0434\u0435\u0448\u044C. \u041F\u043E\u0434
      \u043D\u043E\u0433\u0430\u043C\u0438 \u2014 \u0445\u0440\u0443\u0441\u0442
      \u0431\u0438\u0442\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F, \u0438\u043D\u043E\u0433\u0434\u0430
      \u2014 \u0445\u043B\u044E\u043F\u0430\u043D\u044C\u0435 \u0432\u043E\u0434\u044B,
      \u043F\u0440\u043E\u0441\u043E\u0447\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u041D\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043E\u043D\u0438.
      \u0428\u0438\u043F\u044B. \u0414\u043B\u0438\u043D\u043D\u044B\u0435, \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435,
      \u0431\u0443\u0434\u0442\u043E \u0437\u0443\u0431\u044B \u0441\u043F\u044F\u0449\u0435\u0433\u043E
      \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430, \u0432\u0440\u043E\u0441\u0448\u0438\u0435
      \u0432 \u043F\u043E\u043B \u0438 \u043F\u043E\u0442\u043E\u043B\u043E\u043A.
      \u0416\u0434\u0443\u0442. \u0417\u0434\u0435\u0441\u044C \u043D\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043E\u0448\u0438\u0431\u043E\u043A.\n\u041E\u0434\u0438\u043D
      \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0448\u0430\u0433 \u2014
      \u0438 \u0442\u044C\u043C\u0430 \u0441\u043E\u043C\u043A\u043D\u0435\u0442\u0441\u044F
      \u0432\u043E\u043A\u0440\u0443\u0433, \u043A\u0430\u043A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0432\u0437\u0434\u043E\u0445. \u041D\u043E \u0442\u044B \u0438\u0434\u0435\u0448\u044C.
      \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043D\u0430\u0437\u0430\u0434
      \u0443\u0436\u0435 \u043D\u0435\u0442 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 62870869557248
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0448\u0430\u0433\u0438"
