  - m_Id: 63216224354304
    m_Localized: "\u0417\u0430\u043A\u043E\u043D\u044B \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 75049828139008
    m_Localized: "\u041F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 75255537778688
    m_Localized: "\u0413\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 7503333943721984
    m_Localized: "\u041B\u043E\u0433\u043E\u0432\u043E \u0432 \u0441\u0442\u0435\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 7505076492484608
    m_Localized: "\u0422\u044B \u0432\u043E\u0448\u0451\u043B.\n\u0417\u0434\u0430\u043D\u0438\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0442\u0435\u0441\u043D\u044B\u043C,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0441\u043A\u043B\u0435\u043F \u0434\u043B\u044F
      \u0436\u0438\u0432\u044B\u0445. \u0412\u043E\u0437\u0434\u0443\u0445 \u0441\u043F\u0451\u0440\u0442\u044B\u0439,
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u043C\u0430\u0441\u043B\u0430 \u0438 \u0447\u0435\u0433\u043E-\u0442\u043E
      \u043F\u0440\u043E\u0433\u043E\u0440\u043A\u043B\u043E\u0433\u043E. \u0421\u0442\u0435\u043D\u044B
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E
      \u2014 \u0431\u0443\u0434\u0442\u043E \u0448\u0435\u043F\u0447\u0443\u0442:
      \"\u0417\u0434\u0435\u0441\u044C \u043D\u0435 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F\".\n\u041D\u043E
      \u0432\u0440\u0430\u0433\u0438 \u0443\u0436\u0435 \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0442\u044B \u0437\u0434\u0435\u0441\u044C.\n\u041E\u043D\u0438
      \u0432\u044B\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u044E\u0442
      \u0438\u0437 \u0449\u0435\u043B\u0435\u0439, \u043A\u0430\u043A \u0442\u0435\u043D\u0438,
      \u0437\u0430\u0431\u044B\u0442\u044B\u0435 \u043F\u0440\u0435\u0436\u043D\u0438\u043C\u0438
      \u0445\u043E\u0437\u044F\u0435\u0432\u0430\u043C\u0438. \u0410 \u043C\u0435\u0436\u0434\u0443
      \u0432\u0430\u043C\u0438 \u2014 \u0448\u0438\u043F\u044B. \u0412\u0435\u0437\u0434\u0435.
      \u041D\u0430 \u043F\u043E\u043B\u0443. \u041D\u0430 \u043F\u043E\u0442\u043E\u043B\u043A\u0435.
      \u0414\u0430\u0436\u0435 \u0432 \u0434\u0432\u0435\u0440\u043D\u044B\u0445
      \u043F\u0440\u043E\u0451\u043C\u0430\u0445, \u0431\u0443\u0434\u0442\u043E
      \u044D\u0442\u043E \u043D\u0435 \u043B\u043E\u0432\u0443\u0448\u043A\u0438,
      \u0430 \u0447\u0430\u0441\u0442\u044C \u0441\u0430\u043C\u043E\u0433\u043E
      \u0437\u0434\u0430\u043D\u0438\u044F.\n\u041A\u0430\u0436\u0434\u044B\u0439
      \u0448\u0430\u0433 \u2014 \u0431\u0430\u043B\u0430\u043D\u0441 \u043C\u0435\u0436\u0434\u0443
      \u0430\u0442\u0430\u043A\u043E\u0439 \u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0435\u043C.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u2014 \u0440\u0438\u0441\u043A
      \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043A\u043E\u043B\u044E\u0447\u0435\u0439
      \u0441\u0442\u0430\u043B\u0438.\n\u0422\u044B \u043D\u0435 \u0433\u043E\u0441\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C. \u0422\u044B \u2014 \u043D\u0430\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7518092323766272
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0436\u0435\u0439.\n\u041E\u043D\u0438
      \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F \u043F\u043E \u0441\u0432\u043E\u0438\u043C
      \u0434\u0440\u0435\u0432\u043D\u0438\u043C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044F\u043C,
      \u0441\u043B\u0435\u043F\u044B\u0435 \u0438 \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u044B\u0435.
      \u0418\u0445 \u043A\u043E\u0440\u043F\u0443\u0441\u0430, \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0435
      \u043F\u044B\u043B\u044C\u044E \u0432\u0435\u043A\u043E\u0432, \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043B\u0443\u0442\u044C\u043C\u043E\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u0432.
      \u042D\u0442\u0438 \u0440\u043E\u0431\u043E\u0442\u044B \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0431\u044B\u043B\u0438, \u0437\u0430\u0447\u0435\u043C \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u0443\u044E\u0442
      \u043F\u0443\u0441\u0442\u044B\u0435 \u0437\u0430\u043B\u044B \u2014 \u0442\u0435\u043F\u0435\u0440\u044C
      \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0438\u0442\u0443\u0430\u043B,
      \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0439
      \u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u044B\u0439.\n\u0422\u044B
      \u2014 \u043F\u0440\u0438\u0437\u0440\u0430\u043A \u0432 \u0438\u0445 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u0431\u0430\u043B\u0435\u0442\u0435.\n\u041F\u043E\u043A\u0430 \u043E\u043D\u0438
      \u043D\u0435 \u0432\u0438\u0434\u044F\u0442 \u0442\u0435\u0431\u044F. \u041F\u043E\u043A\u0430
      \u0442\u0432\u043E\u0438 \u0448\u0430\u0433\u0438 \u043B\u0435\u0433\u0447\u0435
      \u043F\u0430\u0434\u0435\u043D\u0438\u044F \u043F\u044B\u043B\u0438\u043D\u043A\u0438.
      \u041D\u043E \u043E\u0434\u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435
      \u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u2014 \u0438 \u0441\u043E\u0442\u043D\u0438
      \u0431\u0435\u0437\u043B\u0438\u043A\u0438\u0445 \u0433\u043E\u043B\u043E\u0432
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u043E.\n\u041C\u0435\u0436\u0434\u0443
      \u0438\u0445 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u043C\u0438 \u2014
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u0438 \u0441 \u0448\u0438\u043F\u0430\u043C\u0438,
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435 \u043F\u043E \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044E.
      \u0418 \u0442\u0435 \u0441\u0430\u043C\u044B\u0435 \u043A\u0430\u043C\u043D\u0438
      \u2014 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0435 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0438,
      \u0433\u043E\u0442\u043E\u0432\u044B\u0435 \u0432 \u043B\u044E\u0431\u043E\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7518060795183104
    m_Localized: "\u041C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0431\u0430\u043B\u0435\u0442"
    m_Metadata:
